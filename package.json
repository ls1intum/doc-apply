{
  "name": "doc-apply",
  "version": "1.2.1",
  "private": true,
  "description": "Modern portal for streamlined, inclusive, and transparent doctoral applications at TUM",
  "license": "MIT",
  "author": {
    "name": "Stephan Krusche",
    "email": "krusche@tum.de",
    "url": "https://aet.cit.tum.de/krusche"
  },
  "scripts": {
    "prebuild": "node prebuild.mjs",
    "build": "pnpm webapp:prod",
    "compile:ts": "pnpm prebuild && tsc --project tsconfig.app.json",
    "compile:ts:tests": "pnpm prebuild && tsc --project tsconfig.spec.json",
    "coverage:pr": "node supporting_scripts/local-pr-coverage/local-pr-coverage.mjs",
    "lint": "eslint .",
    "lint:a11y": "eslint \"src/main/webapp/**/*.html\" --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "prettier:check": "prettier --check \"{,src/**/,webpack/,.blueprint/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,css,scss}\"",
    "prettier:format": "prettier --write \"{,src/**/,webpack/,.blueprint/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,css,scss}\"",
    "serve": "pnpm start",
    "services:up": "docker compose -f docker/local-setup/services.yml up --wait",
    "start": "pnpm prebuild -- --develop && ng serve --hmr",
    "test": "vitest run --coverage",
    "test:ci": "pnpm prebuild && vitest run --coverage.enabled=true --coverage.thresholds.statements=50 --coverage.thresholds.branches=40 --coverage.thresholds.functions=50 --coverage.thresholds.lines=50",
    "test-diff:ci": "pnpm prebuild && bash -lc 'set -eo pipefail; DEFAULT_BRANCH=${GITHUB_BASE_REF:-$(git remote show origin | sed -n \"/HEAD branch/s/.*: //p\")} ; git fetch -q origin \"$DEFAULT_BRANCH\"; CHANGED=$(git diff --name-only --diff-filter=ACMRTUXB \"origin/$DEFAULT_BRANCH\"...HEAD | grep -E \"src/.*\\.(test|spec)\\.(ts|tsx)$\" || true); if [ -n \"$CHANGED\" ]; then echo \"Running changed tests:\"; echo \"$CHANGED\"; pnpm exec vitest run --coverage $CHANGED; else echo \"No changed spec files; running full suite\"; pnpm exec vitest run --coverage; fi'",
    "update": "ncu -i --format group",
    "webapp:build": "pnpm prebuild -- --develop && ng build --configuration development",
    "webapp:dev": "pnpm prebuild -- --develop && ng serve",
    "webapp:prod": "pnpm prebuild && NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration production"
  },
  "config": {
    "default_environment": "prod",
    "packaging": "jar",
    "server_port": 8080
  },
  "dependencies": {
    "@angular/animations": "21.2.18",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/forms": "21.2.18",
    "@angular/localize": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@angular/platform-browser-dynamic": "21.2.18",
    "@angular/router": "21.2.18",
    "@angular/service-worker": "21.2.18",
    "@fortawesome/angular-fontawesome": "4.0.0",
    "@fortawesome/fontawesome-svg-core": "7.2.0",
    "@fortawesome/free-brands-svg-icons": "7.2.0",
    "@fortawesome/free-solid-svg-icons": "7.2.0",
    "@ng-bootstrap/ng-bootstrap": "20.0.0",
    "@ngx-translate/core": "17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "@popperjs/core": "2.11.8",
    "@primeuix/styled": "0.7.4",
    "@primeuix/themes": "2.0.3",
    "@primeuix/utils": "0.7.2",
    "chart.js": "4.5.1",
    "dayjs": "1.11.20",
    "esbuild": "0.28.1",
    "franc-min": "6.2.0",
    "intl-messageformat": "11.2.7",
    "keycloak-js": "26.2.2",
    "ngx-image-cropper": "9.1.6",
    "ngx-quill": "30.1.3",
    "postal-codes-js": "2.5.2",
    "primeicons": "7.0.0",
    "primeng": "21.1.8",
    "quill": "2.0.2",
    "quill-mention": "6.1.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.3.1",
    "@analogjs/vitest-angular": "2.3.1",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
