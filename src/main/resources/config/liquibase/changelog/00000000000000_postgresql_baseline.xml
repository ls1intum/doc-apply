  <changeSet id="000d_add_check_constraints" author="aniruddh">
    <sql>
      ALTER TABLE documents ADD CONSTRAINT chk_documents_owner_xor CHECK ((((doc_owner_type = 'APPLICANT') and (applicant_id is not null) and (application_id is null)) or ((doc_owner_type = 'APPLICATION') and (application_id is not null) and (applicant_id is null))));
      ALTER TABLE images ADD CONSTRAINT chk_default_job_banner_association CHECK (((image_type &lt;&gt; 'DEFAULT_JOB_BANNER') or ((department_id is not null) and (research_group_id is null))));
      ALTER TABLE images ADD CONSTRAINT chk_job_banner_association CHECK (((image_type &lt;&gt; 'JOB_BANNER') or ((research_group_id is not null) and (department_id is null))));
      ALTER TABLE images ADD CONSTRAINT chk_profile_picture_association CHECK (((image_type &lt;&gt; 'PROFILE_PICTURE') or ((research_group_id is null) and (department_id is null))));
    </sql>
  </changeSet>

