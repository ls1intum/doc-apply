<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="001a_migrate_neutral_ratings_to_soft_pass" author="aniruddh">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="ratings" columnName="rating"/>
    </preConditions>
    <sql>
      UPDATE ratings SET rating = 1 WHERE rating = 0;
    </sql>
  </changeSet>

  <changeSet id="001b_migrate_neutral_interviewee_ratings_to_soft_pass" author="aniruddh">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="interviewees" columnName="rating"/>
    </preConditions>
    <sql>
      UPDATE interviewees SET rating = 1 WHERE rating = 0;
    </sql>
  </changeSet>

</databaseChangeLog>
