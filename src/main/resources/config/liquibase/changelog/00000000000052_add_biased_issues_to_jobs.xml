<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="052a_add_biased_issues_to_jobs" author="melissa">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="job_biased_issues"/>
      </not>
    </preConditions>
    <createTable tableName="job_biased_issues">
      <column name="job_id" type="CHAR(36)">
        <constraints nullable="false" foreignKeyName="fk_biased_issues_job" references="jobs(job_id)" deleteCascade="true"/>
      </column>
      <column name="language" type="varchar(10)"/>
      <column name="word" type="varchar(255)"/>
      <column name="type" type="varchar(50)"/>
    </createTable>
  </changeSet>

  <changeSet id="052b_add_unique_constraint_biased_issues" author="aniruddh">
    <preConditions onFail="MARK_RAN">
      <dbms type="mysql"/>
      <!-- MySQL backs a unique constraint with an index of the same name, which is the only probe its snapshot reports reliably -->
      <not>
        <indexExists tableName="job_biased_issues" indexName="uk_biased_issues_job_lang_word_type"/>
      </not>
    </preConditions>
    <addUniqueConstraint
      tableName="job_biased_issues"
      columnNames="job_id, language, word, type"
      constraintName="uk_biased_issues_job_lang_word_type"/>
  </changeSet>

  <changeSet id="052c_rename_gender_bias_score_to_ai_score" author="melissa">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="jobs" columnName="gender_bias_score"/>
      <not>
        <columnExists tableName="jobs" columnName="ai_score"/>
      </not>
    </preConditions>
    <renameColumn
      tableName="jobs"
      oldColumnName="gender_bias_score"
      newColumnName="ai_score"
      columnDataType="integer"/>
  </changeSet>

</databaseChangeLog>
